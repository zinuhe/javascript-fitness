# ─── Postgres (shared container, one DB per service) ───────────────────────────
POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AUTH_DB_NAME=auth_db
CORE_DB_NAME=core_db

# Connection strings consumed by each service (Prisma)
AUTH_DATABASE_URL=postgresql://fitness:fitness_dev_password@localhost:5432/auth_db?schema=public
CORE_DATABASE_URL=postgresql://fitness:fitness_dev_password@localhost:5432/core_db?schema=public

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ─── Service ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CORE_SERVICE_PORT=3002

# ─── Internal service URLs (used by the gateway to reach services) ─────────────
AUTH_SERVICE_URL=http://localhost:3001
CORE_SERVICE_URL=http://localhost:3002

# ─── Misc ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173
