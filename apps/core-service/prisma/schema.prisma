// Core service datastore. Owns the exercise catalog and workout logs.
generator client {
  provider = "prisma-client-js"
  // Isolated output so each service's client doesn't clobber the others in the monorepo.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_DATABASE_URL")
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  legs
  glutes
  core
  full_body
  cardio
}

enum Equipment {
  barbell
  dumbbell
  machine
  cable
  bodyweight
  kettlebell
  bands
  // A single weight plate, like the ones loaded on a barbell.
  disk
  other
}

model Exercise {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  muscleGroup MuscleGroup
  // What it can be done with (at least one); each logged workout says which one was used.
  equipment   Equipment[]
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workoutExercises    WorkoutExercise[]
  routineDayExercises RoutineDayExercise[]

  @@unique([name])
  @@map("exercises")
}

model Workout {
  id           String   @id @default(uuid()) @db.Uuid
  // Logical reference to the auth-service user (no cross-DB FK).
  userId       String   @db.Uuid
  performedAt  DateTime @default(now())
  notes        String?
  // Routine day this session was started from; drives "what's next" in the rotation.
  routineDayId String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exercises  WorkoutExercise[]
  routineDay RoutineDay?       @relation(fields: [routineDayId], references: [id], onDelete: SetNull)

  @@index([userId, performedAt])
  @@index([routineDayId])
  @@map("workouts")
}

model WorkoutExercise {
  id         String @id @default(uuid()) @db.Uuid
  workoutId  String @db.Uuid
  exerciseId String     @db.Uuid
  order      Int
  // Which of the exercise's equipment was used this time (barbell, dumbbell…).
  equipment  Equipment?

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String   @id @default(uuid()) @db.Uuid
  workoutExerciseId String   @db.Uuid
  order             Int
  reps              Int
  weightKg          Decimal  @db.Decimal(6, 2)
  rpe               Decimal? @db.Decimal(3, 1)
  restSeconds       Int?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
  @@map("workout_sets")
}

// A routine (split): N days, each a fixed list of exercises, repeated in order forever.
model Routine {
  id        String   @id @default(uuid()) @db.Uuid
  // Logical reference to the auth-service user (no cross-DB FK).
  userId    String   @db.Uuid
  name      String
  // The routine the user follows now; at most one per user (enforced by the service).
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days RoutineDay[]

  @@index([userId])
  @@map("routines")
}

model RoutineDay {
  id        String  @id @default(uuid()) @db.Uuid
  routineId String  @db.Uuid
  position  Int
  name      String?

  routine   Routine              @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineDayExercise[]
  workouts  Workout[]

  @@index([routineId])
  @@map("routine_days")
}

model RoutineDayExercise {
  id         String @id @default(uuid()) @db.Uuid
  dayId      String @db.Uuid
  exerciseId String @db.Uuid
  position   Int

  day      RoutineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([dayId])
  @@index([exerciseId])
  @@map("routine_day_exercises")
}
