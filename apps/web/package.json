{
  "name": "@fitness/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend SPA \u2014 React + TanStack Router/Query, built with Vite and served by Nginx.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
