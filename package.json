{
  "name": "fitness",
  "version": "0.1.0",
  "private": true,
  "description": "Gym exercise tracker — microservices backend (NestJS + Prisma + Postgres)",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:gateway": "pnpm --filter @fitness/gateway dev",
    "dev:auth": "pnpm --filter @fitness/auth-service dev",
    "dev:core": "pnpm --filter @fitness/core-service dev",
    "start:gateway": "pnpm --filter @fitness/gateway start",
    "start:auth": "pnpm --filter @fitness/auth-service start",
    "start:core": "pnpm --filter @fitness/core-service start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky",
    "docker:dev": "docker compose --env-file .env -f docker/docker-compose.dev.yml up --build",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml up --build -d",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": "prettier --write"
  }
}
